{
  "name": "solo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "SOLO. — Solo training. Zero noise.",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc -b --noEmit",
    "postinstall": "node scripts/fetch-mediapipe-assets.mjs && node scripts/fetch-ffmpeg-assets.mjs",
    "seed:workouts": "node scripts/seed-workouts.mjs",
    "seed:workouts:merge": "node scripts/seed-workouts.mjs --merge",
    "seed:workouts:export": "tsx scripts/export-seed-workouts.ts",
    "seed:workouts:public": "node scripts/seed-workouts.mjs --write"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@garmin/fitsdk": "^21.212.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "clsx": "^2.1.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-markdown": "^10.1.0",
    "react-router": "^8.3.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0"
  }
}
